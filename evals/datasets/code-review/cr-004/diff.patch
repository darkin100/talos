+def is_suppressed(entry: dict, suppressions: list[dict]) -> tuple[bool, dict | None]:
+    """Check if a log entry matches any suppression pattern.
+    
+    Args:
+        entry: log entry dict
+        suppressions: list of {"pattern": "...", ...} dicts
+    
+    Returns:
+        (is_suppressed, suppression_rule) tuple
+    """
+    message = str(entry.get("message") or entry.get("msg") or "")
+    for rule in suppressions:
+        pattern = rule.get("pattern", "")
+        if pattern and pattern in message:
+            return True, rule
+    return False, None
+
